<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@catalogue.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pokemon.ui.CatalogueController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>

    <top>
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="searchField"
                           accessibleText="Card name"
                           promptText="Search cards by name"
                           HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="expansionBox"
                          accessibleText="Expansion"
                          promptText="All expansions" />
                <Button fx:id="clearButton"
                        onAction="#onClearFilters"
                        text="Clear filters" />
            </children>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.25, 0.65">
            <BorderPane.margin>
                <Insets bottom="12.0" left="0.0" right="0.0" top="12.0" />
            </BorderPane.margin>
            <items>
                <ListView fx:id="cardList"
                          accessibleText="Matching cards" />
                <StackPane fx:id="imagePreview"
                           minHeight="0.0"
                           minWidth="0.0"
                           styleClass="image-preview">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                    <children>
                        <Label fx:id="imagePlaceholder"
                               styleClass="image-placeholder"
                               text="Select a card to view its image."
                               wrapText="true" />
                        <ImageView fx:id="cardImage"
                                   accessibleText="Card image"
                                   preserveRatio="true"
                                   smooth="true" />
                    </children>
                </StackPane>
                <TextArea fx:id="details"
                          accessibleText="Card details"
                          editable="false"
                          promptText="Select a card to view its details."
                          styleClass="details-area"
                          wrapText="false">
                    <font>
                        <Font name="Monospaced" size="13.0" />
                    </font>
                </TextArea>
            </items>
        </SplitPane>
    </center>

    <bottom>
        <Label fx:id="resultCount" />
    </bottom>
</BorderPane>
